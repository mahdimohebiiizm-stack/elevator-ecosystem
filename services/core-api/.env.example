# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/elevator_db

# Security & JWT Configuration
SECRET_KEY=replace_with_strong_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:3000,http://127.0.0.1:8000
