<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 380" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#f8fafc"/>
    </linearGradient>
    <filter id="shadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#000000" flood-opacity="0.08"/>
    </filter>
  </defs>

  <rect width="600" height="380" fill="#f1f5f9"/>

  <!-- Bank Receipt Slip Container -->
  <g filter="url(#shadow)">
    <rect x="30" y="20" width="540" height="340" rx="16" fill="url(#bg)" stroke="#cbd5e1" stroke-width="1.5"/>
  </g>

  <!-- Header Banner -->
  <rect x="30" y="20" width="540" height="60" rx="16" fill="#1e293b"/>
  <rect x="30" y="60" width="540" height="20" fill="#1e293b"/>
  
  <!-- Bank Stamp / Header Text -->
  <circle cx="530" cy="50" r="18" fill="#e2e8f0" opacity="0.2"/>
  <text x="500" y="55" fill="#f8fafc" font-size="16" font-family="Tahoma, sans-serif" font-weight="bold" text-anchor="end">بانک ملی ایران - رسید انتقال وجه ساتنا</text>
  <text x="50" y="53" fill="#94a3b8" font-size="12" font-family="monospace">IR-SATNA-2024</text>

  <!-- Green Success Badge -->
  <rect x="420" y="95" width="120" height="28" rx="8" fill="#dcfce7" stroke="#86efac" stroke-width="1"/>
  <text x="480" y="114" fill="#15803d" font-size="12" font-family="Tahoma, sans-serif" font-weight="bold" text-anchor="middle">تراکنش موفق</text>

  <!-- Content Rows -->
  <g font-family="Tahoma, sans-serif" font-size="12" fill="#475569">
    <!-- Row 1 -->
    <text x="520" y="150" text-anchor="end" fill="#64748b">مبلغ انتقال:</text>
    <text x="360" y="150" text-anchor="end" font-size="15" font-weight="bold" fill="#0f172a">۱۴۵,۰۰۰,۰۰۰ ریال (۱۴,۵۰۰,۰۰۰ تومان)</text>

    <!-- Row 2 -->
    <text x="520" y="185" text-anchor="end" fill="#64748b">شماره پیگیری ساتنا:</text>
    <text x="360" y="185" text-anchor="end" font-family="monospace" font-weight="bold" fill="#0284c7">SATNA-88492019482</text>

    <!-- Row 3 -->
    <text x="520" y="220" text-anchor="end" fill="#64748b">نام واریز کننده:</text>
    <text x="360" y="220" text-anchor="end" font-weight="bold" fill="#0f172a">حسین اکبری (بازرگانی نوین آسانسور)</text>

    <!-- Row 4 -->
    <text x="520" y="255" text-anchor="end" fill="#64748b">حساب مقصد:</text>
    <text x="360" y="255" text-anchor="end" font-family="monospace" fill="#0f172a">IR42 0170 0000 0012 3456 7890</text>

    <!-- Row 5 -->
    <text x="520" y="290" text-anchor="end" fill="#64748b">تاریخ و ساعت:</text>
    <text x="360" y="290" text-anchor="end" fill="#0f172a">۱۴۰۳/۰۸/۰۴ - ۱۳:۵۰:۲۲</text>
  </g>

  <!-- Perforated Line / Watermark -->
  <line x1="50" y1="315" x2="550" y2="315" stroke="#e2e8f0" stroke-width="1.5" stroke-dasharray="6,6"/>
  <text x="300" y="340" fill="#94a3b8" font-size="10" font-family="Tahoma, sans-serif" text-anchor="middle">صادر شده توسط سامانه یکپارچه بین بانکی ساتنا / پایا بانک مرکزی جمهوری اسلامی ایران</text>
</svg>
