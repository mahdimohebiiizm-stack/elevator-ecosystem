# ==============================================================================
# Centralized Docker Environment Variables Configuration (.env.docker)
# Elevator Ecosystem - Asanro Etminan Amir Kerman
# ==============================================================================

# Global Environment
ENVIRONMENT=production
DEBUG=False

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_postgres_password_2026!
POSTGRES_DB=postgres
POSTGRES_PORT=5432
CORE_DB_NAME=elevator_db
SHOPBOT_DB_NAME=shopbot_db

# ------------------------------------------------------------------------------
# 2. Redis Configuration
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 3. Core API (Elevator Management Backend)
# ------------------------------------------------------------------------------
CORE_API_PORT=8001
CORE_DATABASE_URL=postgresql://postgres:secure_postgres_password_2026!@postgres:5432/elevator_db
CORE_SECRET_KEY=elev_core_prod_jwt_secret_key_84920491823901238491023
JWT_ALGORITHM=HS256
CORE_TOKEN_EXPIRE_MINUTES=10080
CORE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://localhost:8001

# ------------------------------------------------------------------------------
# 4. Bot Service & Web Storefront API
# ------------------------------------------------------------------------------
BOT_API_PORT=8000
BOT_DATABASE_URL=postgresql+asyncpg://postgres:secure_postgres_password_2026!@postgres:5432/shopbot_db
BOT_CORE_DATABASE_URL=postgresql+asyncpg://postgres:secure_postgres_password_2026!@postgres:5432/elevator_db
BOT_SECRET_KEY=shopbot_prod_jwt_secret_key_59102948192384102938401
BOT_TOKEN_EXPIRE_MINUTES=11520
BOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Bot Webhooks (Optional for production bots)
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=
BASE_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 5. Web Portal (Next.js 14 Standalone Frontend)
# ------------------------------------------------------------------------------
WEB_PORTAL_PORT=3000
INTERNAL_API_URL=http://bot-service:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
